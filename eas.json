{
     "cli": {
          "version": ">= 5.0.0",
          "appVersionSource": "local"
     },
     "build": {
          "development": {
               "developmentClient": true,
               "distribution": "internal",
               "ios": {
                    "simulator": true
               },
               "android": {
                    "buildType": "apk"
               }
          },
          "local": {
               "extends": "development"
          },
          "production": {
               "distribution": "store",
               "autoIncrement": true,
               "env": {
                    "NODE_ENV": "production"
               },
               "ios": {
                    "image": "latest",
                    "buildConfiguration": "Release"
               },
               "android": {
                    "buildType": "app-bundle"
               }
          }
     },
     "submit": {
          "production": {
               "android": {
                    "track": "production"
               },
               "ios": {}
          }
     }
}